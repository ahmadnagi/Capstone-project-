[{"text": "You don't need 8\u201312 reps.", "start": 0.3, "dur": 2.564}, {"text": "We all learned that's the muscle range.", "start": 3.499, "dur": 2.872}, {"text": "But research says 6 to 30 reps all build muscle.", "start": 6.902, "dur": 4.831}, {"text": "On one condition.", "start": 12.334, "dur": 1.122}, {"text": "Push the set until you've got 1 or 2 reps left.", "start": 14.165, "dur": 3.041}, {"text": "Stop at 12 when you could do 20?", "start": 17.67, "dur": 2.639}, {"text": "That's not a set. That's a warm-up.", "start": 20.609, "dur": 3.215}, {"text": "It's not the number.", "start": 24.492, "dur": 2.293}, {"text": "It's the last 2 reps.", "start": 27.069, "dur": 1.602}, {"text": "So pick the range you like.", "start": 29.232, "dur": 2.028}, {"text": "6, 10, 15, 20.", "start": 31.601, "dur": 2.139}, {"text": "You don't need 8\u201312 reps.", "start": 34.382, "dur": 2.564}, {"text": "The last 2 reps need to be tough.", "start": 37.481, "dur": 2.328}]